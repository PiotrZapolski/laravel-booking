{
    "name": "zapol/laravel-booking",
    "description": "Self-hosted booking widget for Laravel apps. Replaces Zencal/Calendly with a config-driven, Google Calendar-synced scheduling page that can be embedded with a single script tag.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "booking", "scheduling", "google-calendar", "calendly", "zencal"],
    "authors": [
        {
            "name": "Piotr Zapolski",
            "email": "zapol1230@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "google/apiclient": "^2.15",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Zapol\\Booking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zapol\\Booking\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zapol\\Booking\\BookingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
