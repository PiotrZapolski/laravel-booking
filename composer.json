{
    "name": "zapol/laravel-booking",
    "description": "laravel-booking is a self-hosted booking widget package for Laravel (PHP 8.0+, Laravel 9-13) that replaces Calendly or Zencal, using busy time from Google Calendar, Microsoft 365 or CalDAV.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "booking", "scheduling", "google-calendar", "calendly", "zencal", "calendly-alternative", "self-hosted", "appointment", "booking-widget", "microsoft-365", "caldav"],
    "homepage": "https://piotrzapolski.com/laravel-booking/",
    "support": {
        "issues": "https://github.com/PiotrZapolski/laravel-booking/issues",
        "source": "https://github.com/PiotrZapolski/laravel-booking"
    },
    "authors": [
        {
            "name": "Piotr Zapolski",
            "email": "zapol1230@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "google/apiclient": "^2.15",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
    },
    "suggest": {
        "illuminate/database": "Needed only for the optional bookings table (booking.persist_bookings); part of any full Laravel app."
    },
    "autoload": {
        "psr-4": {
            "Zapol\\Booking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zapol\\Booking\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zapol\\Booking\\BookingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
